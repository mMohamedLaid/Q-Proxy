{
  "_readme": "Limit schema + verified per-provider limit records + stop order. Reference data: server.js loads and validates it at boot and serves it at GET /admin/api/limit-schema. It does NOT replace the fields that enforce limits today (tpmLimit, rpm/tpm/rpd, dailyCap, retry settings); hops may carry an optional `limits` array in these same record shapes, which is validated and shown but not enforced yet. value null = unknown or unlimited. Anything marked source third-party/unknown is unverified.",
  "enums": {
    "unit": [
      "requests",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "concurrent",
      "points",
      "spend"
    ],
    "scopeLevel": [
      "key",
      "project",
      "account",
      "org",
      "ip",
      "model",
      "process",
      "global"
    ],
    "windowKind": [
      "rolling",
      "fixed",
      "none",
      "one_time"
    ],
    "source": [
      "doc",
      "console",
      "observed",
      "third-party",
      "unknown"
    ],
    "onExceedKind": [
      "quota",
      "concurrency",
      "capacity"
    ]
  },
  "keyRotationHelpsOnlyWhen": "scope.level == key",
  "stopOrder": {
    "beforeSend": [
      "hop inactive/deprecated/gone",
      "one_time balance exhausted",
      "monthly then daily windows",
      "hourly then per-minute windows",
      "request too big for this hop",
      "concurrency (queue briefly or fall through; also where finish-after-disconnect is decided)"
    ],
    "afterSend": [
      {
        "answer": "429 quota (daily/usage/balance)",
        "outcome": "mark record spent until reset; next key if scope=key else next hop; no retry"
      },
      {
        "answer": "429 per-minute",
        "outcome": "Retry-After if short, else next hop"
      },
      {
        "answer": "429 concurrency",
        "outcome": "not quota; back off or next hop"
      },
      {
        "answer": "429 capacity",
        "outcome": "hop degraded for a cooldown; no quota change"
      },
      {
        "answer": "402",
        "outcome": "balance record spent; next hop"
      },
      {
        "answer": "AUTH",
        "outcome": "next key, else halt for that key"
      },
      {
        "answer": "5xx / timeout / reset",
        "outcome": "retry per hop policy, then next hop"
      },
      {
        "answer": "client gone",
        "outcome": "halt, unless finish-after-disconnect applies"
      }
    ],
    "note": "Decide by body code / metadata first, status second. Reserve counters only after every check passes."
  },
  "errorClasses": {
    "1": "noise (deprecated, outage, bad key)",
    "2a": "free information (429 + Retry-After, Groq/AMD headers, OpenRouter X-RateLimit-*)",
    "2b": "costly information (Google 400/500 count against quota; Literouter over-window is trimmed and charged)"
  },
