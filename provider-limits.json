  "literouter": {
    "capturedAt": "2026-11-26",
    "staleAfterDays": 30,
    "source": "Literouter dashboard model cards, re-captured 2026-11-26 (REPLACES the 2026-10-09 table of 62 models: what is listed here is all that is left). Free + Basic.",
    "freeContextTokens": 5000,
    "basicDailyPremiumCredits": 50,
    "basicMaxContextTokens": 15000,
    "notes": "Free tier: fixed 5,000-token context (longer requests are summarized to fit). Basic tier: 50 daily premium credits shared by all premium models; cost per request = base x model multiplier x context multiplier (capped 3.0). freeDailyCap null with hasFree=true means unlimited.",
    "models": {
      "deepseek-v4.1-flash-1017": {
        "hasFree": true,
        "freeDailyCap": null,
        "premiumBasic": true,
        "premiumCost": 1.0,
        "uncensored": true
      },
      "deepseek-v4.1-flash-cheap": {
        "hasFree": true,
        "freeDailyCap": 100,
        "premiumBasic": true,
        "premiumCost": 1.0,
        "uncensored": true
      },
      "deepseek-v4.1-flash": {
        "hasFree": true,
        "freeDailyCap": 100,
        "premiumBasic": true,
        "premiumCost": 1.0,
        "uncensored": true
      },
      "minimax-m3.1-flash": {
        "hasFree": true,
        "freeDailyCap": 100,
        "premiumBasic": true,
        "premiumCost": 1.0,
        "uncensored": true
      },
      "qwen3.6-27b": {
        "hasFree": false,
        "freeDailyCap": null,
        "premiumBasic": true,
        "premiumCost": 1.4,
        "uncensored": true
      }
    },
    "baseContextTokens": 5000,
    "contextNote": "Context Literouter keeps from a long chat. FREE (\":free\", 0x cost) models: fixed freeContextTokens, nothing changes it. BASE models (no suffix, or \":metered\"): default 5,000, raisable with the \"Chat memory\" sliders in the Literouter dashboard (System Context 1x = 1,250 tokens, Conversation Context 1x = 3,750 tokens; equal sliders scale the window, 1x = 5,000, 10x = 50,000; the plan caps a weighted score ((1 x system) + (3 x conversation)) / 4). Q-Proxy cannot read those sliders, so after raising them edit baseContextTokens to match or the [context] warning stays at 5,000. Not affected (full chat or a fixed window): \":full-context\", \":metered:full-context\", \":payg\", \":32k-context\" to \":256k-context\". Longer prompts are summarized by Literouter, never rejected. Observed by hand: non-free models top out at 15,000 for this account; docs.literouter.com/chat-optimization does not publish a per-plan maximum and describes no API or header to change it (dashboard only, as far as the docs say).",
    "standardOnly": [
      "deepseek-v4.1-flash-1017:32k-context",
      "deepseek-v4.1-flash-cheap:32k-context",
      "deepseek-v4.1-flash:32k-context"
    ],
    "standardOnlyNote": "Seen on the 2026-11-26 model cards as \"Requires the Standard plan or permanent credit\" (1.4x-1.8x flat). Not reachable on Basic, so Q-Proxy should not offer them.",
